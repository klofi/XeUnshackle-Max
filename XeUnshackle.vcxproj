  <!--
    Assembles the release package: everything in Dist copied verbatim, plus a default.xex made from the xex we
    just built. Done with tasks rather than a post build event so the Dist tree is mirrored declaratively and
    Clean can undo it - neither of which a one shot cmd script gives us.
  -->
  <Target Name="PackageForUsbRoot" AfterTargets="Build">
    <ItemGroup>
      <_PackageFile Include="$(ProjectDir)Dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <!-- Made up front so xextool has somewhere to write even when Dist\BadUpdatePayload is empty -->
    <MakeDir Directories="$(PackageDir)\BadUpdatePayload" />
    <Copy SourceFiles="@(_PackageFile)" DestinationFiles="@(_PackageFile->'$(PackageDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec Command="&quot;$(ProjectDir)xextool.exe&quot; -m r -r a -o &quot;$(PackageDir)\BadUpdatePayload\default.xex&quot; &quot;$(ImagePath)&quot;" />
    <Message Importance="high" Condition="!Exists('$(PackageDir)\Xbdm.xex')" Text="NOTE: Dist\Xbdm.xex is missing, packaged without it. See BUILD.md." />
    <Message Importance="high" Text="Package ready at $(PackageDir)" />
  </Target>
  <!-- Clean doesn't know about files a custom target created, so the package needs removing by hand -->
  <Target Name="CleanPackage" AfterTargets="Clean">
    <RemoveDir Directories="$(PackageDir)" />
  </Target>
</Project>